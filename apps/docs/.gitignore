# Regenerated on every docs build (see scripts/build-api.mjs), never committed: it can never
# drift from the real public API this way, the same reasoning packages/*/dist/ already follows.
api/
.vitepress/dist/
.vitepress/cache/

# Built by `make embed-playgrounds` (a dependency of docs-dev/docs-preview), never committed:
# playground-react's and playground-vue's own dist/ output, copied here so VitePress serves them
# under /playground/react/ and /playground/vue/ in both dev and build.
public/playground/
