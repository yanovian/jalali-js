{
  "name": "jalali-js-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "probe:treeshake": "node scripts/treeshake-probe.mjs",
    "size": "size-limit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "size-limit": "^13.1.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.2.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "name": "jalali-js (packages/core)",
      "path": "packages/core/dist/index.js",
      "limit": "6 KB"
    }
  ]
}
