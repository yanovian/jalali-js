{
  "name": "jalali-js",
  "version": "0.0.3",
  "description": "The Jalali (Persian, Shamsi) to Gregorian conversion core. TypeScript-native, zero runtime dependencies, framework-agnostic.",
  "keywords": [
    "jalali",
    "persian",
    "shamsi",
    "farsi",
    "iran",
    "calendar",
    "date",
    "typescript"
  ],
  "homepage": "https://yanovian.github.io/jalali-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanovian/jalali-js.git",
    "directory": "packages/core"
  },
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fast-check": "^4.9.0"
  }
}
