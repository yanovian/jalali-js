{
  "name": "@jalali-js/i18n",
  "version": "0.0.3",
  "description": "Locale data and display formatting for jalali-js: English and Farsi, month/weekday names, numerals, and RTL.",
  "keywords": [
    "jalali",
    "persian",
    "farsi",
    "i18n",
    "locale",
    "calendar",
    "date"
  ],
  "homepage": "https://yanovian.github.io/jalali-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanovian/jalali-js.git",
    "directory": "packages/i18n"
  },
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "jalali-js": "workspace:*"
  },
  "devDependencies": {}
}
