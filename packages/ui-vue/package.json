{
  "name": "@jalali-js/ui-vue",
  "version": "0.1.0",
  "description": "RangePicker, EventCalendar, InlineCalendar, and extra themes for @jalali-js/vue, built on the same headless primitives.",
  "keywords": [
    "jalali",
    "persian",
    "farsi",
    "vue",
    "date-range",
    "calendar",
    "theme",
    "shamsi",
    "datepicker",
    "date-range-picker",
    "event-calendar",
    "jalali-calendar"
  ],
  "homepage": "https://jalali-js.yanovian.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanovian/jalali-js.git",
    "directory": "packages/ui-vue"
  },
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/themes/*.css"
  ],
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./themes/*.css": "./src/themes/*.css"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./themes/*.css": "./src/themes/*.css"
    }
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "dependencies": {
    "@jalali-js/holidays": "workspace:*",
    "@jalali-js/i18n": "workspace:*",
    "@jalali-js/vue": "workspace:*",
    "jalali-js": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
