{
  "name": "@jalali-js/react",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/*.css"
  ],
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./date-picker.css": "./src/date-picker.css"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./date-picker.css": "./src/date-picker.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@jalali-js/i18n": "workspace:*",
    "jalali-js": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
