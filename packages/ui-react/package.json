{
  "name": "@jalali-js/ui-react",
  "version": "0.4.1",
  "description": "RangePicker, EventCalendar, InlineCalendar, and extra themes for @jalali-js/react, built on the same headless primitives.",
  "keywords": [
    "jalali",
    "persian",
    "farsi",
    "react",
    "date-range",
    "calendar",
    "theme",
    "shamsi",
    "datepicker",
    "date-range-picker",
    "event-calendar",
    "jalali-calendar"
  ],
  "homepage": "https://jalali-js.yanovian.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanovian/jalali-js.git",
    "directory": "packages/ui-react"
  },
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/themes/*.css"
  ],
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./themes/*.css": "./src/themes/*.css"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./themes/*.css": "./src/themes/*.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@jalali-js/holidays": "workspace:*",
    "@jalali-js/i18n": "workspace:*",
    "@jalali-js/react": "workspace:*",
    "jalali-js": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
