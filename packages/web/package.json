{
  "name": "@jalali-js/web",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Components for jalali-js: a headless Calendar grid and a default-styled DatePicker, usable from plain HTML/JS or any framework.",
  "keywords": [
    "jalali",
    "persian",
    "farsi",
    "web-components",
    "custom-elements",
    "vanilla-js",
    "date-picker",
    "calendar",
    "date"
  ],
  "homepage": "https://yanovian.github.io/jalali-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanovian/jalali-js.git",
    "directory": "packages/web"
  },
  "type": "module",
  "license": "MIT",
  "author": "Yanovian LLC",
  "sideEffects": true,
  "files": [
    "dist",
    "src/*.css"
  ],
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./date-picker.css": "./src/date-picker.css"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./date-picker.css": "./src/date-picker.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@jalali-js/i18n": "workspace:*",
    "jalali-js": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1"
  }
}
